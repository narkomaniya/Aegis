{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Aegis: собрать (g++)",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-O2",
                "-Wall",
                "src\\main.cpp",
                "src\\logger.cpp",
                "src\\watcher.cpp",
                "src\\engine.cpp",
                "src\\quarantine.cpp",
                "src\\attribution.cpp",
                "src\\updater.cpp",
                "src\\autostart.cpp",
                "src\\config.cpp",
                "src\\mods.cpp",
                "src\\animals.cpp",
                "src\\tray.cpp",
                "src\\configs.cpp",
                "src\\doctor.cpp",
                "-o",
                "build\\aegis.exe",
                "-lshell32",
                "-lole32",
                "-luuid"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}
